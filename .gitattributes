# FILE: jigu-app/.gitattributes
# Keep line endings consistent so a Windows checkout and a Linux CI runner
# agree on every text file. Git for Windows would otherwise convert LF -> CRLF
# on checkout for the shell scripts used by the release workflow, which breaks
# them on the ubuntu-latest runner.

* text=auto eol=lf

# Windows-specific scripts keep CRLF so they stay double-clickable in Explorer
# and readable by the legacy cmd.exe parser.
*.cmd text eol=crlf
*.bat text eol=crlf

# Real binaries: never normalise, never diff as text
*.exe binary
*.dll binary
*.ico binary
*.png binary
*.zip binary
*.bundle binary
